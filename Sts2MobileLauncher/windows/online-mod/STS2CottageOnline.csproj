<Project Sdk="Microsoft.NET.Sdk">
  <!-- PC 版联机组件：按 GameVersion 分别引用原版 v0.107.1 / v0.111.0 的 sts2.dll、GodotSharp.dll 与 0Harmony.dll。 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>STS2CottageOnline</AssemblyName>
    <RootNamespace>STS2CottageOnline</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefineConstants Condition="'$(GameVersion)' == 'v0.107.1'">$(DefineConstants);STS2_TARGET_1071</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameReferenceDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameReferenceDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(GameReferenceDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="STS2CottageOnline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
