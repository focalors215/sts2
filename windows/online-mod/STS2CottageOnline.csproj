<Project Sdk="Microsoft.NET.Sdk">
  <!-- PC 版联机组件：由 tools/windows/build-online-mod.sh 构建，引用目录 = 原版 v0.111.0 data 目录（sts2.dll / GodotSharp.dll / 0Harmony.dll）。 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>STS2CottageOnline</AssemblyName>
    <RootNamespace>STS2CottageOnline</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameReferenceDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameReferenceDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(GameReferenceDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="STS2CottageOnline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
